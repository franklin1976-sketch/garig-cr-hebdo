<?xml version="1.0" encoding="utf-8"?>
<!--
  Emplacements que FileProvider autorise à partager avec une autre application.
  Surensemble de la configuration livrée par Capacitor : les greffons Filesystem et
  Share continuent de fonctionner, et le dossier « cache » utilisé par le module
  d'envoi e-mail y est explicitement déclaré.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <files-path name="files" path="." />
    <cache-path name="cache" path="." />
    <external-path name="external" path="." />
    <external-files-path name="external_files" path="." />
    <external-cache-path name="external_cache" path="." />
    <external-media-path name="external_media" path="." />
</paths>
